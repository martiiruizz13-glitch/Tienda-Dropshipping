<!doctype html>
<html class="no-js{% if request.design_mode %} zp-design-mode{% endif %}" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#1A0912">
    <meta name="format-detection" content="telephone=no">
    {%- liquid
      assign brand = 'Zaldori'
      if request.page_type == 'index'
        assign zp_title = 'Zarpa · Las zapatillas de gatito que dejan huellas · Zaldori'
        assign zp_description = 'Zarpa, de Zaldori: zapatillas de casa con carita de gato y suela de patita que deja huellas. 5 capas de calidez, forro lavable e impermeables. El regalo más tierno de estas Navidades.'
      else
        assign zp_title = page_title | append: ' · ' | append: brand
        assign zp_description = page_description | default: shop.description
      endif
    -%}
    <title>{{ zp_title }}</title>
    {%- if zp_description != blank %}
      <meta name="description" content="{{ zp_description | strip_html | escape }}">
    {%- endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:site_name" content="{{ brand }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ zp_title | escape }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:description" content="{{ zp_description | strip_html | escape }}">
    {%- if page_image %}
      <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {%- else %}
      <meta property="og:image" content="https:{{ 'zaldori-logo.png' | asset_url }}">
    {%- endif %}
    <meta name="twitter:card" content="summary_large_image">

    <link rel="icon" type="image/png" href="{{ 'zaldori-favicon.png' | asset_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'zaldori-symbol.svg' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'zaldori-apple-touch.png' | asset_url }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,500;1,9..144,700&family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap">

    {{ 'zp.css' | asset_url | stylesheet_tag: preload: true }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.ZP = {
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        }
      };
    </script>
    <script src="{{ 'zp.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="zp{% if template.name == 'index' %} zp--overlay{% endif %}">
    <a class="zp-skip" href="#MainContent">Saltar al contenido</a>
    <svg width="0" height="0" class="zp-defs" aria-hidden="true" focusable="false">
    <symbol id="zp-paw" viewBox="0 0 64 64">
      <ellipse cx="32" cy="42" rx="14" ry="12" fill="currentColor"/>
      <ellipse cx="14" cy="26" rx="6" ry="8" fill="currentColor"/>
      <ellipse cx="25" cy="15" rx="6" ry="8" fill="currentColor"/>
      <ellipse cx="39" cy="15" rx="6" ry="8" fill="currentColor"/>
      <ellipse cx="50" cy="26" rx="6" ry="8" fill="currentColor"/>
    </symbol>
  </svg>
    <canvas class="zp-snow" data-zp-snow aria-hidden="true"></canvas>

    {% section 'zp-header' %}

    <main id="MainContent" class="zp-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'zp-footer' %}

    {%- render 'zp-cart-drawer' -%}
  </body>
</html>
