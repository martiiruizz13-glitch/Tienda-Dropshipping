      "blocks": {
        "f1": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo se carga?",
            "respuesta": "Con el cable USB incluido, desde cualquier cargador de móvil, ordenador o batería externa. Cárgalo antes del primer uso."
          }
        },
        "f2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Puedo mezclar bebidas calientes?",
            "respuesta": "Frías o templadas, sí. Hirviendo no, para cuidar el motor y evitar quemaduras."
          }
        },
        "f3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo se limpia?",
            "respuesta": "Lava el vaso con agua y un poco de jabón. La base lleva el motor y la batería: no la sumerjas ni la metas en el lavavajillas."
          }
        },
        "f4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Qué diferencia hay entre Clásico y Estilizado?",
            "respuesta": "El Clásico tiene tapa con asa y boquilla abatible. El Estilizado tiene una silueta más fina y botón frontal. Los dos se usan igual."
          }
        },
        "f5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuánto tarda en llegar?",
            "respuesta": "Enviamos gratis a toda España con número de seguimiento. El plazo habitual es de 12 a 25 días."
          }
        },
        "f6": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Y si no me convence?",
            "respuesta": "Tienes 14 días desde que lo recibes para cambiar de opinión, y 3 años de garantía legal frente a defectos de fabricación."
          }
        }
      },
