{%- comment -%}
  Global navigation: a 44px bar that scrolls away. The local bar below it stays.
  Mobile: logo, search, bag and a menu that opens a full-screen black sheet.
{%- endcomment -%}
<nav class="zn-gnav" aria-label="Global">
  <div class="zn-gnav__inner">
    <a class="zn-gnav__logo" href="{{ routes.root_url }}" aria-label="Zaldori, inicio">
      {%- render 'zn-logo', variant: 'symbol' -%}
    </a>
    <ul class="zn-gnav__list" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><a class="zn-gnav__link" href="{{ block.settings.url }}">{{ block.settings.label | escape }}</a></li>
      {%- endfor -%}
    </ul>
    <div class="zn-gnav__tools">
      <button class="zn-gnav__icon" type="button" data-zn-search-open aria-haspopup="dialog" aria-controls="zn-search" aria-keyshortcuts="/">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.25" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M15.2 15.2 20 20" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <span class="zn-visually-hidden">Buscar</span>
      </button>
      <button class="zn-gnav__icon zn-cart-btn" type="button" data-zn-cart-open aria-haspopup="dialog" aria-controls="zn-cart">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5.5 8.5h13l-1 11.5h-11z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        <span class="zn-visually-hidden">Carrito,</span>
        <span class="zn-cart-count" data-zn-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
        <span class="zn-visually-hidden">artículos</span>
      </button>
      <button class="zn-gnav__icon zn-gnav__menu" type="button" data-zn-menu-open aria-haspopup="dialog" aria-controls="zn-menu">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 9.5h14M5 14.5h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <span class="zn-visually-hidden">Abrir menú</span>
      </button>
    </div>
  </div>
</nav>

<dialog class="zn-menu" id="zn-menu" aria-label="Menú">
  <div class="zn-menu__panel">
    <div class="zn-menu__top">
      <span class="zn-menu__logo">{%- render 'zn-logo', variant: 'symbol' -%}</span>
      <button class="zn-gnav__icon" type="button" data-zn-menu-close>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <span class="zn-visually-hidden">Cerrar menú</span>
      </button>
    </div>
    <ul class="zn-menu__list" role="list">
      {%- for block in section.blocks -%}
        <li style="--i: {{ forloop.index0 }};"><a href="{{ block.settings.url }}" data-zn-menu-link>{{ block.settings.label | escape }}</a></li>
      {%- endfor -%}
    </ul>
    <p class="zn-menu__contact">Atención al cliente<br><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
  </div>
</dialog>

{% schema %}
{
  "name": "Noir · Barra global",
  "class": "zn-gnav-section",
  "settings": [
    { "type": "text", "id": "email", "label": "Email de atención", "default": "support@zaldori.com" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Enlace",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Vortix" },
        { "type": "text", "id": "url", "label": "Destino", "default": "#vortix" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link", "settings": { "label": "Vortix", "url": "#vortix" } },
      { "type": "link", "settings": { "label": "TermoCalm", "url": "#termocalm" } },
      { "type": "link", "settings": { "label": "Pulsia", "url": "#pulsia" } },
      { "type": "link", "settings": { "label": "Comparar", "url": "#elige" } },
      { "type": "link", "settings": { "label": "Campaña", "url": "#campana" } },
      { "type": "link", "settings": { "label": "Ayuda", "url": "#ayuda" } }
    ]
  }
}
{% endschema %}
