{%- comment -%}
  Hero product stage: a small centred lockup, an all-caps display statement and the three
  products floating in a 3D scene (real photos with the background removed). The scene
  follows the pointer and opens in depth as you scroll (zn.js). Purchase stack underneath.
{%- endcomment -%}
{%- liquid
  assign from_price = nil
  for p in collections.all.products limit: 24
    if from_price == nil or p.price_min < from_price
      assign from_price = p.price_min
    endif
  endfor
-%}
<section class="zn-hero" data-zn-hero aria-labelledby="zn-hero-title-{{ section.id }}">
  <div class="zn-hero__lockup" data-zn-fade>
    <span class="zn-hero__mark">{%- render 'zn-logo', variant: 'symbol' -%}</span>
    <span class="zn-hero__brand">{{ section.settings.eyebrow | escape }}</span>
  </div>
  <h1 class="zn-hero__title" id="zn-hero-title-{{ section.id }}" data-zn-hero-title>
    {%- for i in (1..3) -%}
      {%- capture key %}line_{{ i }}{% endcapture -%}
      {%- if section.settings[key] != blank %}<span class="zn-mask"><span class="zn-mask__in">{{ section.settings[key] | escape }}</span></span>{% unless forloop.last %} {% endunless %}{% endif -%}
    {%- endfor -%}
  </h1>

  <div class="zn-scene" data-zn-scene role="img" aria-label="{{ section.settings.alt | escape }}">
    <div class="zn-scene__rig" data-zn-scene-rig>
      {%- for i in (1..3) -%}
        {%- capture a %}layer_{{ i }}{% endcapture -%}
        {%- capture lw %}layer_{{ i }}_w{% endcapture -%}
        {%- capture lh %}layer_{{ i }}_h{% endcapture -%}
        {%- if section.settings[a] != blank -%}
          <div class="zn-scene__layer zn-scene__layer--{{ i }}" data-zn-layer="{{ i }}">
            {%- if i == 2 -%}{%- assign prio = true -%}{%- else -%}{%- assign prio = false -%}{%- endif -%}
            {%- render 'zn-render', asset: section.settings[a], width: section.settings[lw], height: section.settings[lh], alt: '', priority: prio -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="zn-hero__stack" data-zn-fade>
    <a class="zn-pill zn-pill--buy zn-pill--lg" href="{{ section.settings.cta_url }}" data-zn-magnetic>{{ section.settings.cta_label | escape }}</a>
    <p class="zn-hero__price">
      {%- if from_price -%}Desde {{ from_price | money }}{%- endif -%}
      <span>{{ section.settings.capsule | escape }}</span>
    </p>
    {%- if section.settings.badge != blank -%}<p class="zn-badge">{{ section.settings.badge | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Noir · Portada",
  "tag": "div",
  "class": "zn-section zn-section--hero",
  "settings": [
    { "type": "text", "id": "badge", "label": "Etiqueta", "default": "Disponible" },
    { "type": "text", "id": "eyebrow", "label": "Marca", "default": "Zaldori" },
    { "type": "text", "id": "line_1", "label": "Titular, línea 1", "default": "Mezcla." },
    { "type": "text", "id": "line_2", "label": "Titular, línea 2", "default": "Calienta." },
    { "type": "text", "id": "line_3", "label": "Titular, línea 3", "default": "Descansa." },
    { "type": "text", "id": "capsule", "label": "Texto bajo el precio", "default": "Envío gratis a España" },
    { "type": "text", "id": "cta_label", "label": "Botón", "default": "Comprar" },
    { "type": "text", "id": "cta_url", "label": "Destino del botón", "default": "#elige" },
    { "type": "text", "id": "alt", "label": "Descripción de la escena", "default": "TermoCalm, Pulsia y Vortix flotando sobre fondo negro" },
    { "type": "header", "content": "Productos sin fondo (imágenes del tema)" },
    { "type": "text", "id": "layer_1", "label": "Izquierda", "default": "zn-c-termocalm.webp" },
    { "type": "number", "id": "layer_1_w", "label": "Izquierda: ancho", "default": 1200 },
    { "type": "number", "id": "layer_1_h", "label": "Izquierda: alto", "default": 800 },
    { "type": "text", "id": "layer_2", "label": "Centro", "default": "zn-c-pulsia.webp" },
    { "type": "number", "id": "layer_2_w", "label": "Centro: ancho", "default": 1200 },
    { "type": "number", "id": "layer_2_h", "label": "Centro: alto", "default": 1200 },
    { "type": "text", "id": "layer_3", "label": "Derecha", "default": "zn-c-vortix-rosa.webp" },
    { "type": "number", "id": "layer_3_w", "label": "Derecha: ancho", "default": 800 },
    { "type": "number", "id": "layer_3_h", "label": "Derecha: alto", "default": 1200 }
  ],
  "presets": [ { "name": "Noir · Portada" } ]
}
{% endschema %}
