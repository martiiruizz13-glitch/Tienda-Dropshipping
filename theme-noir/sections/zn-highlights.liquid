{%- comment -%}
  "Conoce los tres": one large rounded media card per product.
  Without JavaScript it is a horizontal snap carousel; on desktop zn.js pins it and
  crossfades card to card as you scroll, with story-style progress segments.
{%- endcomment -%}
<section class="zn-hl" id="{{ section.settings.anchor }}" data-zn-hl aria-labelledby="zn-hl-title-{{ section.id }}">
  <div class="zn-hl__pin" data-zn-hl-pin>
    <div class="zn-wrap zn-hl__head">
      <h2 class="zn-h2" id="zn-hl-title-{{ section.id }}" data-zn-lines>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="zn-hl__track" data-zn-hl-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign media_index = block.settings.media_index | minus: 1
          assign img = block.settings.image
          if img == blank and block.settings.asset == blank and p != blank and p.media.size > media_index
            assign img = p.media[media_index].preview_image
          endif
        -%}
        <article class="zn-hl__card" data-zn-hl-card aria-labelledby="zn-hl-{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="zn-hl__media" data-zn-hl-media>
            {%- render 'zn-image', image: img, asset: block.settings.asset, asset_width: 1600, asset_height: 1600, sizes: '(min-width: 990px) 46vw, 84vw', alt: block.settings.alt, class_name: 'zn-hl__img' -%}
          </div>
          <div class="zn-hl__copy" data-zn-hl-copy>
            <p class="zn-hl__num">Nº {{ block.settings.number }}</p>
            <h3 class="zn-hl__name" id="zn-hl-{{ block.id }}">{{ block.settings.title | escape }}</h3>
            <p class="zn-hl__line">{{ block.settings.line | escape }}</p>
            {%- if block.settings.specs != blank -%}<p class="zn-hl__specs">{{ block.settings.specs | escape }}</p>{%- endif -%}
            {%- if p != blank -%}<p class="zn-hl__price">{% if p.price_varies %}Desde {% endif %}{{ p.price_min | money }}</p>{%- endif -%}
            <div class="zn-hl__actions">
              <a class="zn-pill zn-pill--buy" href="{{ block.settings.url }}-comprar">Comprar<span class="zn-visually-hidden"> {{ block.settings.title | escape }}</span></a>
              <a class="zn-more" href="{{ block.settings.url }}">Más información<span class="zn-visually-hidden"> sobre {{ block.settings.title | escape }}</span></a>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <ol class="zn-hl__dots" aria-hidden="true">
      {%- for block in section.blocks -%}<li data-zn-hl-dot><span></span></li>{%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Noir · Destacados",
  "tag": "div",
  "class": "zn-section zn-section--hl",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla", "default": "salas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Conoce los tres." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Producto",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto" },
        { "type": "text", "id": "title", "label": "Nombre", "default": "Vortix" },
        { "type": "text", "id": "number", "label": "Número", "default": "01" },
        { "type": "text", "id": "line", "label": "Frase", "default": "Tu batido perfecto, sin grumos, en segundos." },
        { "type": "text", "id": "specs", "label": "Ficha breve" },
        { "type": "text", "id": "url", "label": "Ancla del capítulo", "default": "#vortix" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "range", "id": "media_index", "label": "Si no hay imagen: foto nº", "min": 1, "max": 20, "step": 1, "default": 1 },
        { "type": "text", "id": "asset", "label": "Imagen del tema" },
        { "type": "text", "id": "alt", "label": "Texto alternativo" }
      ]
    }
  ],
  "presets": [ { "name": "Noir · Destacados" } ]
}
{% endschema %}
