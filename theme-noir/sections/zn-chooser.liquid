{%- comment -%}
  Quick chooser. Desktop: three columns side by side, read as one comparison.
  Mobile: a tab list ("Quiero…") showing one product at a time. Without JS every column shows.
{%- endcomment -%}
<section class="zn-chooser zn-paper" id="{{ section.settings.anchor }}" data-zn-chooser aria-labelledby="zn-chooser-title-{{ section.id }}">
  <div class="zn-wrap">
   <div class="zn-module zn-chooser__module">
    <h2 class="zn-h2 zn-chooser__title" id="zn-chooser-title-{{ section.id }}" data-zn-lines>{{ section.settings.heading | escape }}</h2>

    <div class="zn-chooser__tabs" role="tablist" aria-label="Elige según lo que buscas" data-zn-tabs hidden>
      {%- for block in section.blocks -%}
        <button class="zn-chooser__tab" type="button" role="tab" id="zn-tab-{{ block.id }}" aria-controls="zn-panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {% unless forloop.first %}tabindex="-1"{% endunless %} style="--tab-tint: {{ block.settings.tint }};">
          {{- block.settings.need | escape -}}
        </button>
      {%- endfor -%}
    </div>

    <div class="zn-chooser__cols">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <div class="zn-pick " id="zn-panel-{{ block.id }}" role="tabpanel" aria-labelledby="zn-tab-{{ block.id }}" style="--pick-tint: {{ block.settings.tint }};" {{ block.shopify_attributes }} data-zn-panel>
          <div class="zn-pick__media">
            {%- liquid
              assign pimg = block.settings.image
              if pimg == blank and block.settings.asset == blank and p != blank
                assign pimg = p.featured_media.preview_image
              endif
            -%}
            {%- render 'zn-image', image: pimg, asset: block.settings.asset, asset_width: 1600, asset_height: 1600, sizes: '(min-width: 990px) 26vw, 70vw', alt: '', class_name: 'zn-pick__img' -%}
          </div>
          <p class="zn-pick__need">{{ block.settings.need | escape }}</p>
          <h3 class="zn-pick__name">{{ block.settings.name | escape }}</h3>
          <dl class="zn-pick__rows">
            <div><dt>Para</dt><dd>{{ block.settings.moment | escape }}</dd></div>
            <div><dt>Lo esencial</dt><dd>{{ block.settings.essentials | escape }}</dd></div>
            {%- if p != blank -%}
              <div><dt>Opciones</dt><dd>
                {%- if p.has_only_default_variant or p.variants.size == 1 -%}
                  {{ p.variants.first.title | escape }}
                {%- else -%}
                  {{ p.variants.size }} {{ p.options.first | downcase | escape }}
                {%- endif -%}
              </dd></div>
              <div><dt>Precio</dt><dd class="zn-pick__price">{% if p.price_varies %}desde {% endif %}{{ p.price_min | money }}</dd></div>
            {%- endif -%}
          </dl>
          <div class="zn-pick__actions">
            <a class="zn-pill zn-pill--buy" href="{{ block.settings.url }}">Comprar<span class="zn-visually-hidden"> {{ block.settings.name | escape }}</span></a>
            <a class="zn-more" href="{{ block.settings.url | split: '-comprar' | first }}">Más información<span class="zn-visually-hidden"> sobre {{ block.settings.name | escape }}</span></a>
          </div>
        </div>
      {%- endfor -%}
    </div>
   </div>
  </div>
</section>

{% schema %}
{
  "name": "Noir · Selector",
  "tag": "div",
  "class": "zn-section zn-section--chooser",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla", "default": "elige" },
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Cuál es el tuyo?" }
  ],
  "blocks": [
    {
      "type": "pick",
      "name": "Producto",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto" },
        { "type": "text", "id": "name", "label": "Nombre", "default": "Vortix" },
        { "type": "text", "id": "need", "label": "Necesidad", "default": "Quiero mezclar" },
        { "type": "text", "id": "moment", "label": "Momento", "default": "Después de entrenar, por la mañana o en la oficina." },
        { "type": "text", "id": "essentials", "label": "Lo esencial", "default": "400 ml · hasta 7000 rpm · recargable por USB" },
        { "type": "text", "id": "url", "label": "Destino", "default": "#vortix-comprar" },
        { "type": "color", "id": "tint", "label": "Color", "default": "#DDE3D8" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "asset", "label": "Imagen del tema" }
      ]
    }
  ],
  "presets": [ { "name": "Noir · Selector" } ]
}
{% endschema %}
