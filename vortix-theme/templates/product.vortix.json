    "features": {
      "type": "vx-features",
      "blocks": {
        "ft-1": {
          "type": "feature",
          "settings": {
            "fallback_index": 2,
            "title": "Efecto vórtice a 7000 rpm",
            "text": "La base crea un remolino a alta velocidad que disuelve el polvo por completo. Batidos cremosos, sin bolas de proteína en el último trago."
          }
        },
        "ft-2": {
          "type": "feature",
          "settings": {
            "fallback_index": 4,
            "title": "Recargable por USB",
            "text": "Batería de 1200 mAh. Lo cargas con el cable incluido y te olvidas de enchufes durante días."
          }
        },
        "ft-3": {
          "type": "feature",
          "settings": {
            "fallback_index": 1,
            "title": "400 ml con escala",
            "text": "El tamaño justo para tu batido, un café con leche o un smoothie. La escala impresa te ahorra el medidor."
          }
        },
        "ft-4": {
          "type": "feature",
          "settings": {
            "fallback_index": 3,
            "title": "Tapa de un clic",
            "text": "Abres y bebes directamente del vaso, sin desenroscar nada. Cierra firme para llevarlo en la bolsa."
          }
        },
        "ft-5": {
          "type": "feature",
          "settings": {
            "fallback_index": 6,
            "title": "Ligero e irrompible",
            "text": "ABS, PP y PC: materiales resistentes para el día a día. 10,5 × 8,6 × 19 cm y un diseño que te apetece sacar en cualquier sitio."
          }
        }
      },
