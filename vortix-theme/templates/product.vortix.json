    "faq": {
      "type": "vx-faq",
      "blocks": {
        "qa-1": {
          "type": "qa",
          "settings": {
            "q": "¿Cómo se usa?",
            "a": "Añade primero el líquido (agua, leche o bebida vegetal), después la proteína en polvo, cierra la tapa y pulsa el botón de la base. En unos segundos lo tienes listo."
          }
        },
        "qa-2": {
          "type": "qa",
          "settings": {
            "q": "¿Cuánto dura la batería?",
            "a": "La batería de 1200 mAh da para muchos batidos con una sola carga (depende de la duración de cada uso). Se carga por USB (5 V / 1 A) con el cable incluido. Cárgalo antes del primer uso."
          }
        },
        "qa-3": {
          "type": "qa",
          "settings": {
            "q": "¿Se puede meter en el lavavajillas?",
            "a": "No. La base lleva el motor y la batería: limpia el vaso con agua y un paño suave, sin sumergir la base. Un truco: agua con una gota de jabón, pulsa unos segundos y aclara."
          }
        },
        "qa-4": {
          "type": "qa",
          "settings": {
            "q": "¿Sirve para fruta o hielo?",
            "a": "Vortix es un mezclador, no una batidora de cuchillas: está pensado para polvos y líquidos (proteína, cacao, café soluble, avena fina). No tritura fruta entera ni hielo."
          }
        },
        "qa-5": {
          "type": "qa",
          "settings": {
            "q": "¿Puedo usar bebidas calientes?",
            "a": "Úsalo con bebidas frías o templadas. Nunca con líquidos hirviendo."
          }
        },
        "qa-6": {
          "type": "qa",
          "settings": {
            "q": "¿Cuánto tarda el envío?",
            "a": "El envío es gratis a toda España y llega normalmente en 8–15 días laborables. Recibirás un número de seguimiento por email."
          }
        },
        "qa-7": {
          "type": "qa",
          "settings": {
            "q": "¿Y si no me convence?",
            "a": "Tienes 14 días desde que lo recibes para desistir de la compra. Además cuenta con la garantía legal de 3 años frente a defectos de fabricación."
          }
        }
      },
