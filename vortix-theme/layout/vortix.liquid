<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#141210">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/svg+xml" href="{{ 'vx-favicon.svg' | asset_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'meta-tags' %}

    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
    {{ 'vx.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'vx-js');
      try { if (sessionStorage.getItem('vx-seen') || matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('vx-no-loader'); } catch (e) {}
      window.vxConfig = {
        moneyFormat: {{ shop.money_format | json }},
        cartUrl: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
        cartChange: {{ routes.cart_change_url | append: '.js' | json }},
        cartJs: {{ routes.cart_url | append: '.js' | json }},
        freeShip: 0
      };
    </script>
    <script src="{{ 'vx-gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vx-scrolltrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vx.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="vx-body template-{{ template.name }}">
    <a class="vx-skip" href="#MainContent">Saltar al contenido</a>

    <div class="vx-loader" aria-hidden="true">
      <div class="vx-loader__inner">
        <svg class="vx-loader__rings" viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="54" stroke="rgba(250,247,242,.12)" stroke-width="2"/>
          <circle class="vx-loader__r1" cx="60" cy="60" r="54" stroke="#ff5a1f" stroke-width="3" stroke-dasharray="80 260"/>
          <circle class="vx-loader__r2" cx="60" cy="60" r="38" stroke="#ff8a4c" stroke-width="3" stroke-dasharray="50 190"/>
          <circle class="vx-loader__r3" cx="60" cy="60" r="22" stroke="#faf7f2" stroke-width="3" stroke-dasharray="30 110"/>
        </svg>
        <div class="vx-loader__num"><span data-loader-num>0000</span></div>
        <div class="vx-loader__label">rpm</div>
      </div>
    </div>

    {% section 'vx-header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'vx-footer' %}

    {% render 'vx-cart-drawer' %}
  </body>
</html>
