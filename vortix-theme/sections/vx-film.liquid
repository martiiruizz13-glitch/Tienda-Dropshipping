{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: var(--vx-ink); }
  #shopify-section-{{ section.id }} .vx-h2 { font-size: clamp(2.4rem, 1.4rem + 4vw, {{ section.settings.title_size }}px); }
{% endstyle %}
<section class="vx-film vx-section vx-dark" id="{{ section.settings.anchor }}" data-film>
  <div class="vx-wrap">
    <div class="vx-film__head">
      <div>
        <span class="vx-eyebrow" data-reveal>{{ section.settings.eyebrow }}</span>
        <h2 class="vx-h2" style="margin-top:1rem" data-reveal>{{ section.settings.title }}</h2>
      </div>
      <p class="vx-lead" data-reveal>{{ section.settings.text | newline_to_br }}</p>
    </div>

    <div class="vx-film__screen" data-reveal>
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, preload: 'metadata', class: 'vx-film__video', image_size: '1600x' }}
        <div class="vx-film__controls">
          <button class="vx-film__play" type="button" aria-label="Pausar vídeo" data-film-video-toggle>{% render 'vx-icon', name: 'pause' %}</button>
        </div>
      {%- else -%}
        <div class="vx-film__kicker" aria-hidden="true">{{ section.settings.kicker }}</div>
        <div class="vx-film__big" aria-hidden="true" data-film-big>7000</div>
        <div class="vx-film__stage" aria-hidden="true">
          <div class="vx-film__cup" data-film-cup>
            <svg viewBox="0 0 200 330" fill="none">
              <defs>
                <clipPath id="vxCupClip-{{ section.id }}"><rect x="38" y="52" width="124" height="206" rx="16"/></clipPath>
                <linearGradient id="vxLiquid-{{ section.id }}" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#d9a77a"/><stop offset="1" stop-color="#7a4a2c"/>
                </linearGradient>
                <radialGradient id="vxGlow-{{ section.id }}"><stop offset="0" stop-color="#ff5a1f" stop-opacity=".9"/><stop offset="1" stop-color="#ff5a1f" stop-opacity="0"/></radialGradient>
              </defs>
              <circle cx="100" cy="296" r="80" fill="url(#vxGlow-{{ section.id }})" opacity="0" data-film-glow/>
              <g data-film-powder>
                <circle cx="88" cy="-10" r="4" fill="#e8d3b8"/><circle cx="104" cy="-30" r="3" fill="#d9bf9b"/><circle cx="96" cy="-52" r="5" fill="#e8d3b8"/>
                <circle cx="112" cy="-16" r="3.5" fill="#c9a77f"/><circle cx="80" cy="-40" r="3" fill="#d9bf9b"/><circle cx="118" cy="-60" r="4" fill="#e8d3b8"/>
                <circle cx="92" cy="-80" r="3" fill="#c9a77f"/><circle cx="108" cy="-96" r="4.5" fill="#e8d3b8"/><circle cx="100" cy="-120" r="3" fill="#d9bf9b"/>
              </g>
              <g clip-path="url(#vxCupClip-{{ section.id }})">
                <g data-film-liquid>
                  <path d="M-60 0 Q -40 -9 -20 0 T 20 0 T 60 0 T 100 0 T 140 0 T 180 0 T 220 0 T 260 0 V 270 H -60 Z" fill="url(#vxLiquid-{{ section.id }})" data-film-wave/>
                </g>
                <g data-film-lumps fill="#efe0cb">
                  <circle cx="70" cy="200" r="6"/><circle cx="122" cy="220" r="5"/><circle cx="95" cy="180" r="4"/><circle cx="135" cy="190" r="4.5"/><circle cx="60" cy="232" r="4"/>
                </g>
                <g data-film-swirl opacity="0" stroke="#fff3e6" stroke-width="3" stroke-linecap="round">
                  <ellipse cx="100" cy="170" rx="52" ry="14" stroke-dasharray="70 40" opacity=".55"/>
                  <ellipse cx="100" cy="200" rx="40" ry="11" stroke-dasharray="50 30" opacity=".7"/>
                  <ellipse cx="100" cy="228" rx="26" ry="8" stroke-dasharray="30 20" opacity=".85"/>
                  <ellipse cx="100" cy="248" rx="12" ry="4" stroke-dasharray="14 8"/>
                </g>
              </g>
              <rect x="32" y="46" width="136" height="218" rx="20" stroke="rgba(250,247,242,.55)" stroke-width="2.5" fill="rgba(250,247,242,.04)"/>
              <path d="M150 90 v120" stroke="rgba(250,247,242,.25)" stroke-width="5" stroke-linecap="round"/>
              <g stroke="rgba(250,247,242,.35)" stroke-width="2"><path d="M44 110h12M44 140h18M44 170h12M44 200h18M44 230h12"/></g>
              <g data-film-lid>
                <rect x="28" y="22" width="144" height="28" rx="10" fill="#2a2622" stroke="rgba(250,247,242,.4)" stroke-width="2"/>
                <rect x="70" y="10" width="40" height="16" rx="6" fill="#3a3530"/>
              </g>
              <rect x="28" y="262" width="144" height="50" rx="16" fill="#2a2622" stroke="rgba(250,247,242,.3)" stroke-width="2"/>
              <circle cx="100" cy="287" r="11" fill="#141210" stroke="#ff5a1f" stroke-width="3" data-film-button/>
              <circle cx="100" cy="287" r="11" stroke="#ff5a1f" stroke-width="2" opacity="0" data-film-ripple/>
            </svg>
          </div>
        </div>
        <div class="vx-film__caption" aria-hidden="true">
          <span data-film-cap>{{ section.settings.cap_1 }}</span>
          <span data-film-cap>{{ section.settings.cap_2 }}</span>
          <span data-film-cap>{{ section.settings.cap_3 }}</span>
          <span data-film-cap class="vx-accent-text">{{ section.settings.cap_4 }}</span>
          <span data-film-cap>{{ section.settings.cap_5 }}</span>
        </div>
        <div class="vx-film__flash" aria-hidden="true" data-film-flash></div>
        <ol class="vx-sr">
          <li>{{ section.settings.cap_1 }}</li><li>{{ section.settings.cap_2 }}</li><li>{{ section.settings.cap_3 }}</li><li>{{ section.settings.cap_4 }}</li><li>{{ section.settings.cap_5 }}</li>
        </ol>
        <div class="vx-film__controls">
          <button class="vx-film__play" type="button" aria-label="Pausar animación" data-film-toggle>{% render 'vx-icon', name: 'pause' %}</button>
          <div class="vx-film__bar" aria-hidden="true"><i data-film-progress></i></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VX – Anuncio animado",
  "tag": "div",
  "settings": [
    { "type": "video", "id": "video", "label": "Tu vídeo (opcional, sustituye a la animación)" },
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Míralo en acción" },
    { "type": "text", "id": "title", "label": "Título", "default": "5 segundos. Literal." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Sin batidora, sin bolas de proteína en el último trago, sin brazo cansado. Solo un botón." },
    { "type": "range", "id": "title_size", "label": "Tamaño máximo del título (px)", "min": 40, "max": 140, "step": 4, "default": 104 },
    { "type": "text", "id": "kicker", "label": "Texto superior de la animación", "default": "Vortix · el ritual" },
    { "type": "text", "id": "cap_1", "label": "Escena 1", "default": "Echa tu proteína." },
    { "type": "text", "id": "cap_2", "label": "Escena 2", "default": "Añade agua o leche." },
    { "type": "text", "id": "cap_3", "label": "Escena 3", "default": "Pulsa una vez." },
    { "type": "text", "id": "cap_4", "label": "Escena 4", "default": "7000 rpm." },
    { "type": "text", "id": "cap_5", "label": "Escena 5", "default": "Listo. Cero grumos." },
    { "type": "text", "id": "anchor", "label": "Ancla (id para enlaces)", "default": "video" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "default": 120 }
  ],
  "presets": [ { "name": "VX – Anuncio animado" } ]
}
{% endschema %}
