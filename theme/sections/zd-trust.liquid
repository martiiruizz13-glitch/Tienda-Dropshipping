{%- comment -%}
  Store promises. Only content the store can back; anything unconfirmed is written
  as [PENDIENTE: …] in the settings so the owner sees it before publishing.
{%- endcomment -%}
<section class="zd-trust" id="{{ section.settings.anchor }}" aria-labelledby="zd-trust-title-{{ section.id }}">
  <div class="zd-wrap zd-trust__grid">
    <h2 class="zd-h2 zd-trust__title" id="zd-trust-title-{{ section.id }}" data-zd-lines>{{ section.settings.heading | escape }}</h2>
    <dl class="zd-trust__list">
      {%- for block in section.blocks -%}
        <div class="zd-trust__item" {{ block.shopify_attributes }} data-zd-fade>
          <dt>{{ block.settings.title | escape }}</dt>
          <dd>{{ block.settings.text | escape }}</dd>
        </div>
      {%- endfor -%}
    </dl>
    <div class="zd-trust__contact" data-zd-fade>
      <p>{{ section.settings.contact_text | escape }}</p>
      <a class="zd-trust__mail" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="zd-payments" role="list" aria-label="Métodos de pago aceptados">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'zd-payments__icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zaldori · Confianza",
  "tag": "div",
  "class": "zd-section zd-section--trust",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla", "default": "confianza" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Comprar aquí, sin dudas." },
    { "type": "text", "id": "contact_text", "label": "Texto de contacto", "default": "¿Alguna pregunta antes o después de comprar? Escríbenos y te responde una persona." },
    { "type": "text", "id": "email", "label": "Email", "default": "support@zaldori.com" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Promesa",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Envío gratis a España" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [ { "name": "Zaldori · Confianza" } ]
}
{% endschema %}
