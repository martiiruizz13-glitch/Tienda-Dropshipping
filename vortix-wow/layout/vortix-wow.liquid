<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#0c0b14">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'vx-favicon.svg' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'meta-tags' %}

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@500;700;800&family=Playfair+Display:ital,wght@1,500&display=swap" rel="stylesheet">
    {{ 'vw.css' | asset_url | stylesheet_tag }}

    {%- liquid
      assign first_variant = product.selected_or_first_available_variant
    -%}
    <style>
      :root {
        --vw-accent: {{ settings.vw_accent | default: '#d7ff3a' }};
        --vw-accent-2: {{ settings.vw_accent_2 | default: '#7b5cff' }};
        --vw-tint: {% if first_variant %}{% render 'vw-tint', value: first_variant.title %}{% else %}#e9e4da{% endif %};
      }
    </style>

    <script>
      (function (d) {
        var c = d.documentElement;
        c.className = c.className.replace('no-js', 'vw-js');
        /* Si las animaciones no llegan a cargar, el contenido se muestra igualmente. */
        setTimeout(function () { if (!window.vwReady) c.classList.add('vw-nofx'); }, 4000);
      })(document);
      window.vwConfig = {
        moneyFormat: {{ shop.money_format | json }},
        cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
        cartChange: {{ routes.cart_change_url | append: '.js' | json }},
        cartJs: {{ routes.cart_url | append: '.js' | json }},
        checkout: '/checkout'
      };
    </script>
    {%- if product -%}
      <script type="application/json" id="vw-product">{{ product | json }}</script>
      <script type="application/json" id="vw-tints">
        {
          {%- for v in product.variants -%}
            "{{ v.id }}": "{% render 'vw-tint', value: v.title %}"{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      </script>
    {%- endif -%}
    <script src="{{ 'vx-gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vx-scrolltrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vw.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="vw-body template-{{ template.name }}">
    <a class="vw-skip" href="#MainContent">Saltar al contenido</a>

    {% section 'vw-header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'vw-footer' %}

    {% render 'vw-cart' %}
  </body>
</html>
