{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: var(--vw-ink); }
  #shopify-section-{{ section.id }} .vw-rpm__num { font-size: clamp(5.5rem, 2rem + 19vw, {{ section.settings.number_size }}px); }
{% endstyle %}

<section class="vw-rpm vw-section" data-rpm data-tone="ink">
  <div class="vw-rpm__stage" data-rpm-stage>
    <div class="vw-rpm__halo" aria-hidden="true" data-rpm-halo></div>
    <div class="vw-wrap vw-rpm__grid">
      <div class="vw-rpm__head">
        <p class="vw-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="vw-rpm__title vw-h2" data-split>{{ section.settings.title }}</h2>
      </div>

      <div class="vw-rpm__meter">
      <div class="vw-rpm__dial" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          <circle class="vw-rpm__track" cx="100" cy="100" r="92"/>
          <circle class="vw-rpm__arc" cx="100" cy="100" r="92" pathLength="100" data-rpm-arc/>
        </svg>
      </div>

      <ol class="vw-rpm__list" data-rpm-list>
        {%- for block in section.blocks -%}
          <li class="vw-rpm__item{% if forloop.first %} is-active{% endif %}" data-rpm-item data-value="{{ block.settings.number }}" {{ block.shopify_attributes }}>
            <p class="vw-rpm__num vw-display"><span data-rpm-num>{{ block.settings.number }}</span><small>{{ block.settings.unit }}</small></p>
            <p class="vw-rpm__label">{{ block.settings.label }}</p>
            {%- if block.settings.text != blank -%}<p class="vw-rpm__text">{{ block.settings.text }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
      </div>

      <div class="vw-rpm__steps" aria-hidden="true">
        {%- for block in section.blocks -%}<span data-rpm-step{% if forloop.first %} class="is-active"{% endif %}></span>{%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VW – Cifras (fijadas)",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "En cifras" },
    { "type": "text", "id": "title", "label": "Titular", "default": "Pequeño por fuera. Potente por dentro." },
    { "type": "range", "id": "number_size", "label": "Tamaño máximo de las cifras (px)", "min": 96, "max": 320, "step": 8, "unit": "px", "default": 208 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Cifra",
      "settings": [
        { "type": "text", "id": "number", "label": "Número (solo cifras)", "default": "7000" },
        { "type": "text", "id": "unit", "label": "Unidad", "default": "rpm" },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Velocidad de mezcla" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [ { "name": "VW – Cifras (fijadas)", "blocks": [ { "type": "stat" } ] } ]
}
{% endschema %}
